# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C / C++ build outputs
*.o
*.obj
*.exe
*.out
*.dylib
*.dll
*.so

# Environments
.env
.venv
env/
venv/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Temporary directories and OS files
*.tmp
*~
.DS_Store
Thumbs.db
temp_workspace/
scratch/

# Large artifacts/reports if generated dynamically
# (keep directory structures and .gitkeep tracked)
data/processed/*.tmp
