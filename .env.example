# ==============================================================================
# AI-Based Compiler Error Detection & Repair Configuration
# ==============================================================================

# Server Network Configuration
APP_HOST=127.0.0.1
APP_PORT=8765

# Model Provider Selection: "mock" (default, offline), "ollama" (local LLM), or "hosted" (cloud API)
MODEL_PROVIDER=mock

# ------------------------------------------------------------------------------
# Ollama Local LLM Configuration (When MODEL_PROVIDER=ollama)
# ------------------------------------------------------------------------------
# URL where Ollama daemon is running (default: http://localhost:11434)
# In Docker, use: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Recommended local coding models:
# - deepseek-coder:6.7b (or deepseek-coder:1.3b)
# - qwen2.5-coder:7b (or qwen2.5-coder:1.5b)
# - codellama:7b
# - llama3:8b
OLLAMA_MODEL=deepseek-coder

# ------------------------------------------------------------------------------
# Hosted Cloud LLM Configuration (When MODEL_PROVIDER=hosted / openai / gemini)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AIza...
